# Copy to your shell or the hosting dashboard. Never commit real values.
APP_ENV=dev                       # dev | prod
PORT=8080
DATABASE_URL=postgres:///eneba?sslmode=disable
# 32 random bytes, base64. Generate: openssl rand -base64 32  (required when APP_ENV=prod)
KEY_ENCRYPTION_KEY=
# Comma-separated origins allowed to send POST/PUT/DELETE (required when APP_ENV=prod)
TRUSTED_ORIGINS=http://localhost:5173
